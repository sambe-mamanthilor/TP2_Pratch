---
import GraphicSpecies from "../components/GraphicSpecies.astro";
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <title>TP2 - Slider & IntersectionObserver</title>
  </head>
  <body class="p-8">
    <header class="sticky top-0 bg-white p-4 shadow-md z-10 mb-6">
      <nav class="flex gap-4">
        <a href="#adelie" class="menu-item px-4 py-2 rounded transition-colors">Adelie</a>
        <a href="#gentoo" class="menu-item px-4 py-2 rounded transition-colors">Gentoo</a>
        <a href="#chinstrap" class="menu-item px-4 py-2 rounded transition-colors">Chinstrap</a>
      </nav>
    </header>

    <!-- Slider horizontal CSS -->
    <main class="flex overflow-x-auto snap-x snap-mandatory gap-8 pb-8">
      <section id="adelie" class="item min-w-full snap-center bg-gray-50 p-6 rounded-lg">
        <h2 class="text-xl font-bold mb-4">Adelie</h2>
        <GraphicSpecies species="Adelie" />
      </section>

      <section id="gentoo" class="item min-w-full snap-center bg-gray-50 p-6 rounded-lg">
        <h2 class="text-xl font-bold mb-4">Gentoo</h2>
        <GraphicSpecies species="Gentoo" />
      </section>

      <section id="chinstrap" class="item min-w-full snap-center bg-gray-50 p-6 rounded-lg">
        <h2 class="text-xl font-bold mb-4">Chinstrap</h2>
        <GraphicSpecies species="Chinstrap" />
      </section>
    </main>
  </body>
</html>