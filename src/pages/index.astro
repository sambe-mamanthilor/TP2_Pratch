---
import PlotFigure from "../components/PlotFigure.astro";
import Layout from "../layouts/Layout.astro";
import * as Plot from "@observablehq/plot";
import penguins from "../assets/penguins.json";
---

<Layout>
  <main class="mx-auto max-w-5xl px-6 py-12">
    <p class="mb-2 text-sm font-semibold uppercase tracking-[0.2em] text-blue-700">TP2 · Observable Plot</p>
    <h1 class="text-4xl font-bold tracking-tight text-slate-900">Les manchots de Palmer</h1>
    <p class="mt-3 max-w-2xl text-slate-600">Comparez les espèces avec des graphiques filtrés ou explorez chaque population sur sa propre page.</p>
    <nav class="mt-8 flex flex-wrap gap-3" aria-label="Accès aux graphiques">
      <a href="/species" class="rounded-md bg-blue-700 px-4 py-3 font-semibold text-white hover:bg-blue-800">Comparer les trois espèces</a>
      <a href="/species/Adelie" class="rounded-md border border-slate-300 px-4 py-3 font-semibold text-slate-700 hover:bg-slate-100">Voir les pages séparées</a>
    </nav>
    <section class="mt-14 rounded-lg border border-slate-200 bg-white p-4 shadow-sm md:p-8" aria-label="Vue d'ensemble des données">
      <h2 class="mb-5 text-xl font-semibold text-slate-900">Vue d'ensemble</h2>
      <PlotFigure
        options={{
          marks: [
            Plot.dot(penguins, {
              x: "culmen_length_mm",
              y: "culmen_depth_mm",
              stroke: "species",
            }),
          ],
          grid: true,
        }}
      />
    </section>
  </main>
</Layout>
